// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel CSMain

struct MeshInfo{
	float3 position;
	float3 normal;
	float3 tangent;
};

// Create a RenderTexture with enableRandomWrite flag and set it
// with cs.SetTexture
RWTexture2D<float4> OutPosition;
RWTexture2D<float4> OutNormal;
StructuredBuffer<MeshInfo> Info;
int VertCount;
int FrameCount;

// Texture layout matches how the VAT shaders read it: width = vertex axis
// (sampled from the built-in VertexID node), height = frame axis (sampled
// with a continuous 0..1 time value). Info is populated frame-major
// (frame*VertCount + vertex) by the baking pass, so id.x is the vertex and
// id.y is the frame for both the buffer lookup and the output pixel.
[numthreads(8,8,1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
	if ((int)id.x >= VertCount || (int)id.y >= FrameCount)
	{
		return;
	}

	int index = (int)id.y * VertCount + (int)id.x;
	MeshInfo info = Info[index];

	OutPosition[id.xy] = float4(info.position, 1.0);
	OutNormal[id.xy] = float4(info.normal, 1.0);
}
